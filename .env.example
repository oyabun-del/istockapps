# Шаблон для разработки (docker compose up). Для production: .env.production.example и docs/DEPLOY.md

# ---------- Docker ----------
# Чтобы `docker compose …` без -f запускал dev-окружение (hot reload)
COMPOSE_FILE=compose.dev.yaml

# ---------- Общие ----------
# Если не указать, будет production со всеми защитами
NODE_ENV=development
PORT=3000
# Интерфейс, который слушает сервер (по умолчанию все)
# HOST=0.0.0.0
LOG_LEVEL=info
# Сколько reverse-proxy стоит перед сервером (Caddy/nginx = 1). 0 = не доверять X-Forwarded-For
TRUST_PROXY_HOPS=0

# ---------- Telegram ----------
# Токен бота от @BotFather (заглушка намеренно не проходит проверку: сервер не стартует, пока её не заменить)
BOT_TOKEN=123456789:CHANGE_ME
# Username бота без @ (нужен, чтобы после оплаты вернуть покупателя в бота)
BOT_USERNAME=your_shop_bot
# Адрес Mini App и публичный адрес сервера (callback Platega, тестовая страница оплаты).
# Для проверки в браузере — http://localhost:5173, для Telegram — HTTPS-туннель на :5173
WEBAPP_URL=http://localhost:5173
PUBLIC_URL=http://localhost:5173

# Канал для обязательной подписки: @username или -100… (бот должен быть админом канала)
REQUIRED_CHANNEL=@your_channel
# Обязательно, если REQUIRED_CHANNEL задан числовым id (ссылка-приглашение)
# REQUIRED_CHANNEL_URL=https://t.me/+invite
# false — магазин открыт всем без подписки; канал остаётся только ссылкой в профиле. По умолчанию true
# REQUIRE_CHANNEL_SUBSCRIPTION=true

# Telegram id администраторов через запятую. Каждый должен нажать /start в боте.
ADMIN_IDS=111111111,222222222
# Аккаунт поддержки (без @)
SUPPORT_USERNAME=your_support
# Название магазина для пользовательского соглашения и политики конфиденциальности (страницы в профиле).
# Обязательны в production; в разработке можно не указывать, но тогда оба сразу
# SELLER_NAME=iStockApps
# Почта для запросов по персональным данным (152-ФЗ)
# SELLER_EMAIL=shop@example.com
# Скорость рассылки (/broadcast), сообщений в секунду: 1–30, по умолчанию 25
# BROADCAST_RATE_PER_SEC=25
# Часовой пояс дней в /stats и в итогах дня (IANA), по умолчанию Europe/Moscow
# STATS_TIME_ZONE=Europe/Moscow
# Когда админам приходят итоги дня, ЧЧ:ММ в STATS_TIME_ZONE, по умолчанию 23:55
# DAILY_REPORT_TIME=23:55

# ---------- База данных ----------
# Postgres в Docker: внутри контейнеров DATABASE_URL задаётся в compose.dev.yaml / compose.yaml.
# Для `pnpm dev` на хосте: `docker compose -f compose.dev.yaml up -d db`, затем `pnpm db:deploy` и эта строка:
# DATABASE_URL=postgresql://istock:istock@localhost:5432/istock

# ---------- Оплата (Platega) ----------
# Обязательно: mock (тестовая страница оплаты без денег) или platega (реальный API)
PAYMENT_PROVIDER=mock
# Из личного кабинета Platega → «Настройки»
# PLATEGA_MERCHANT_ID=0192a4b8-0000-7000-8000-000000000000
# PLATEGA_SECRET=
# PLATEGA_API_URL=https://app.platega.io
# В кабинете Platega → «Настройки» → Callback URLs укажите: ${PUBLIC_URL}/webhooks/platega

# ---------- Каталог и выдача ----------
# mock (заглушки для разработки) или installios (https://api.installios.ru/docs); оба значения одинаковые
CATALOG_PROVIDER=mock
DELIVERY_PROVIDER=mock
# Ключ партнёра Install-IOS: только на сервере, никогда в Mini App и в Git
# INSTALLIOS_API_KEY=
# INSTALLIOS_API_BASE=https://api.installios.ru/v1
# Install-IOS не передаёт цены: общая цена в рублях и, при желании, отдельные цены по app_id
# INSTALLIOS_DEFAULT_PRICE_RUB=199
# INSTALLIOS_PRICES={"app_example": 299}

# ---------- Только для разработки ----------
# Позволяет открыть Mini App в обычном браузере без Telegram.
# Только NODE_ENV=development и PAYMENT_PROVIDER=mock. Подписка проверяется, если не включён TELEGRAM_OFFLINE.
# DEV_USER_ID=111111111
# Работа без бота (BOT_TOKEN не нужен): подписка считается оформленной, уведомления пишутся в лог.
# Только development + mock-оплата и вместе с DEV_USER_ID.
# TELEGRAM_OFFLINE=true
SERVE_MINIAPP=true
