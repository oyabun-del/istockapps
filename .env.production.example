# Production: скопируйте в .env на сервере и заполните (docs/DEPLOY.md).
# NODE_ENV, PORT, TRUST_PROXY_HOPS, WEBAPP_URL, PUBLIC_URL и DATABASE_URL задаёт compose.yaml.

# ---------- Домен и HTTPS ----------
# Домен без https:// — A-запись должна указывать на IP сервера
DOMAIN=shop.example.com
# Почта для Let's Encrypt (предупреждения об истечении сертификатов)
ACME_EMAIL=admin@example.com

# ---------- База данных ----------
# Только буквы и цифры (входит в URL подключения): openssl rand -hex 24
POSTGRES_PASSWORD=

# ---------- Общие ----------
LOG_LEVEL=info

# ---------- Telegram ----------
BOT_TOKEN=
BOT_USERNAME=your_shop_bot
# @username или -100… (бот должен быть админом канала)
REQUIRED_CHANNEL=@your_channel
# Обязательно, если REQUIRED_CHANNEL — числовой id
# REQUIRED_CHANNEL_URL=https://t.me/+invite
# Каждый админ должен нажать /start в боте
ADMIN_IDS=111111111
SUPPORT_USERNAME=your_support
# Реквизиты ИП: показываются в пользовательском соглашении и политике конфиденциальности. Обязательны
SELLER_NAME=
# 12 цифр
SELLER_INN=
# 15 цифр
SELLER_OGRNIP=
# Почта для запросов по персональным данным (152-ФЗ)
SELLER_EMAIL=
# Скорость рассылки (/broadcast), сообщений в секунду: 1–30, по умолчанию 25
# BROADCAST_RATE_PER_SEC=25

# ---------- Оплата (CISPAY) ----------
PAYMENT_PROVIDER=cispay
CISPAY_SHOP_ID=
CISPAY_API_KEY=
# Webhook в кабинете CISPAY: https://<DOMAIN>/webhooks/cispay
# true — засчитывать платежи «Песочницы» (только на время проверки!)
ALLOW_SANDBOX_PAYMENTS=false

# ---------- Каталог и выдача (Install-IOS) ----------
CATALOG_PROVIDER=installios
DELIVERY_PROVIDER=installios
INSTALLIOS_API_KEY=
INSTALLIOS_DEFAULT_PRICE_RUB=199
# INSTALLIOS_PRICES={"app_example": 299}
# INSTALLIOS_API_BASE=https://api.installios.ru/v1
