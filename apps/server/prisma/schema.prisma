// Postgres everywhere (dev and prod run it in Docker, see compose.yaml / compose.dev.yaml).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         BigInt   @id // Telegram user id
  firstName  String
  lastName   String?
  username   String?
  photoUrl   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  orders     Order[]
}

model Order {
  id              Int          @id @default(autoincrement())
  // Sent to CISPAY as order_id; random so it never collides after DB resets.
  paymentOrderId  String       @unique
  userId          BigInt
  user            User         @relation(fields: [userId], references: [id])
  appId           String
  appName         String
  appIconUrl      String
  amountKopecks   Int
  paymentMethod   String
  status          String
  paymentId       String?      @unique
  paymentUrl      String?
  paymentSyncedAt DateTime?
  // Install-IOS order id and deadline. Links, credentials and codes are never stored.
  deliveryRef       String?   @unique
  deliveryExpiresAt DateTime?
  // Login code received (or not asked by Apple): unlocks the last activation step.
  codeReceivedAt  DateTime?
  paidAt          DateTime?
  completedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  events          OrderEvent[]
  codeWaits       CodeWaitAttempt[]

  @@index([userId, createdAt])
}

// One explicit attempt to receive a login code: ids only, the code itself is never stored.
model CodeWaitAttempt {
  id             Int      @id @default(autoincrement())
  orderId        Int
  order          Order    @relation(fields: [orderId], references: [id])
  groupId        String
  idempotencyKey String   @unique
  waitId         String?  @unique
  createdAt      DateTime @default(now())

  @@index([orderId, groupId])
}

model OrderEvent {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id])
  type      String
  data      String?
  createdAt DateTime @default(now())

  @@index([orderId])
}
