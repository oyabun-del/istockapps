// Postgres everywhere (dev and prod run it in Docker, see compose.yaml / compose.dev.yaml).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         BigInt   @id // Telegram user id
  firstName  String
  lastName   String?
  username   String?
  photoUrl   String?
  // Set when a message to the user failed with 403 (bot blocked); cleared by /start.
  botBlockedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  orders     Order[]
}

model Order {
  id              Int          @id @default(autoincrement())
  // Sent to CISPAY as order_id; random so it never collides after DB resets.
  paymentOrderId  String       @unique
  userId          BigInt
  user            User         @relation(fields: [userId], references: [id])
  // Sum of app prices before the bulk discount; amountKopecks is what the buyer pays.
  subtotalKopecks Int
  discountKopecks Int          @default(0)
  amountKopecks   Int
  paymentMethod   String
  status          String
  paymentId       String?      @unique
  paymentUrl      String?
  paymentSyncedAt DateTime?
  // Install-IOS order id and deadline. Links, credentials and codes are never stored.
  deliveryRef       String?   @unique
  deliveryExpiresAt DateTime?
  // Login code received (or not asked by Apple): unlocks the last activation step.
  codeReceivedAt  DateTime?
  paidAt          DateTime?
  completedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  items           OrderItem[]
  events          OrderEvent[]
  codeWaits       CodeWaitAttempt[]

  @@index([userId, createdAt])
}

// One app of an order, priced when the order was created.
model OrderItem {
  id              Int    @id @default(autoincrement())
  orderId         Int
  order           Order  @relation(fields: [orderId], references: [id])
  appId           String
  appName         String
  appIconUrl      String
  priceKopecks    Int
  discountKopecks Int    @default(0)

  @@unique([orderId, appId])
}

// One explicit attempt to receive a login code: ids only, the code itself is never stored.
model CodeWaitAttempt {
  id             Int      @id @default(autoincrement())
  orderId        Int
  order          Order    @relation(fields: [orderId], references: [id])
  groupId        String
  idempotencyKey String   @unique
  waitId         String?  @unique
  createdAt      DateTime @default(now())

  @@index([orderId, groupId])
}

model OrderEvent {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id])
  type      String
  data      String?
  createdAt DateTime @default(now())

  @@index([orderId])
}

// A message an admin sent to the bot, copied to every user as is (formatting, custom emoji, media).
model Broadcast {
  id                Int       @id @default(autoincrement())
  authorId          BigInt
  status            String
  // The admin's own message; the copy keeps its entities, so nothing is re-rendered.
  sourceChatId      BigInt?
  sourceMessageId   Int?
  buttons           Json      @default("[]")
  // The admin's message with the counters, edited while sending.
  progressMessageId Int?
  // Last user id handled; sending resumes after it on restart.
  cursorUserId      BigInt?
  total             Int       @default(0)
  sent              Int       @default(0)
  blocked           Int       @default(0)
  failed            Int       @default(0)
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([authorId, status])
  @@index([status])
}
